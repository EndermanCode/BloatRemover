{
  "schemaVersion": 5,
  "name": "Beispiel-SAP-Arbeitsplatz",
  "createdAt": "2026-08-04T00:00:00.0000000+02:00",
  "startupMode": "prompt",
  "continueToMainMenuAfterStartup": false,
  "skipIfAlreadyApplied": true,
  "restartExplorer": false,
  "energy": {
    "preset": "Balanced",
    "timeouts": null,
    "fastStartup": "disabled",
    "hibernation": "unchanged",
    "usbPowerSaving": "enabled"
  },
  "actions": [
    {
      "action": "runTask",
      "name": "HP-Bloatware entfernen",
      "type": "system",
      "task": "hpDebloat"
    },
    {
      "action": "replaceFile",
      "name": "Firmenkonfiguration verteilen",
      "type": "file",
      "source": "Files\\company-config.ini",
      "target": "%ProgramData%\\BeispielFirma\\config.ini",
      "sha256": null,
      "backupExisting": true,
      "createDirectory": true
    },
    {
      "action": "uninstall",
      "name": "Alte Beispielsoftware entfernen",
      "type": "winget",
      "id": null,
      "matchName": "Alte Beispielsoftware"
    },
    {
      "action": "uninstall",
      "name": "Microsoft Bing News",
      "type": "appx",
      "packageName": "Microsoft.BingNews",
      "packageFamilyName": "Microsoft.BingNews_8wekyb3d8bbwe"
    },
    {
      "action": "uninstall",
      "name": "Altes Desktop-Programm",
      "type": "registry",
      "matchName": "Altes Desktop-Programm"
    },
    {
      "action": "install",
      "name": "7-Zip",
      "type": "winget",
      "id": "7zip.7zip",
      "source": "winget"
    },
    {
      "action": "install",
      "name": "SAP GUI",
      "type": "exe",
      "path": "Installers\\SAPSetup.exe",
      "arguments": "/Silent",
      "detectName": "SAP GUI",
      "sha256": null,
      "successExitCodes": [
        0,
        1641,
        3010
      ]
    }
  ]
}
